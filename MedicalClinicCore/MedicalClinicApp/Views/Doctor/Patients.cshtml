@model List<MedicalClinicApp.Models.Patient>
@{ ViewData["Title"] = "My Patients"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-people"></i> My Patients</h2>
    <a asp-action="Dashboard" class="btn btn-outline-primary mb-3"><i class="bi bi-arrow-left"></i> Back</a>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Gender</th><th>DOB</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr><td>@p.PatientID</td><td>@p.FullName</td><td>@p.Email</td><td>@p.Phone</td><td>@p.Gender</td><td>@p.DOB?.ToString("MMM dd, yyyy")</td>
                    <td><a asp-action="CreatePrescription" asp-route-patientId="@p.PatientID" class="btn btn-sm btn-warning"><i class="bi bi-capsule"></i> Rx</a></td></tr>
                }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No patients assigned</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
