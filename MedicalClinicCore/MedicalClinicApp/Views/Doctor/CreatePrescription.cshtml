@model MedicalClinicApp.Models.Prescription
@{ ViewData["Title"] = "New Prescription"; var patients = (List<MedicalClinicApp.Models.Patient>)ViewBag.Patients; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-capsule"></i> New Prescription</h2>
    <div class="card p-4">
        <form asp-action="CreatePrescription" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Patient</label>
                    <select asp-for="PatientID" class="form-select">
                        @foreach (var p in patients) { <option value="@p.PatientID" selected="@(p.PatientID == (int?)ViewBag.SelectedPatientId)">@p.FullName</option> }
                    </select>
                </div>
                <div class="col-md-6"><label class="form-label">Medication</label><input asp-for="Medication" class="form-control" required /></div>
                <div class="col-md-4"><label class="form-label">Dosage</label><input asp-for="Dosage" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">Frequency</label><input asp-for="Frequency" class="form-control" placeholder="e.g., Twice daily" /></div>
                <div class="col-md-4"><label class="form-label">Quantity</label><input asp-for="Quantity" type="number" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Start Date</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">End Date</label><input asp-for="EndDate" type="date" class="form-control" /></div>
                <div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
                <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Create</button> <a asp-action="Prescriptions" class="btn btn-outline-secondary">Cancel</a></div>
            </div>
        </form>
    </div>
</div>
