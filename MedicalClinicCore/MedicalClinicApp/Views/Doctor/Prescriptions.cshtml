@model List<MedicalClinicApp.Models.Prescription>
@{ ViewData["Title"] = "Prescriptions"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-capsule"></i> Prescriptions</h2>
    <div class="d-flex gap-2 mb-3">
        <a asp-action="Dashboard" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back</a>
        <a asp-action="CreatePrescription" class="btn btn-success"><i class="bi bi-plus"></i> New Prescription</a>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Patient</th><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Start</th><th>End</th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                { <tr><td>@p.PrescriptionID</td><td>@(p.Patient?.FullName ?? "N/A")</td><td>@p.Medication</td><td>@p.Dosage</td><td>@p.Frequency</td><td>@p.StartDate?.ToString("MMM dd")</td><td>@p.EndDate?.ToString("MMM dd")</td></tr> }
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No prescriptions</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
