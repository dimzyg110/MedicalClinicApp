@model List<MedicalClinicApp.Models.Appointment>
@{ ViewData["Title"] = "All Appointments"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-calendar"></i> All Appointments</h2>
    <a asp-action="Index" class="btn btn-outline-primary mb-3"><i class="bi bi-arrow-left"></i> Back</a>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Date</th><th>Time</th><th>Patient</th><th>Doctor</th><th>Office</th><th>Approved</th><th>Confirmed</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr><td>@a.AppointmentID</td><td>@a.AppointmentDate?.ToString("MMM dd, yyyy")</td><td>@a.AppointmentTime?.ToString(@"hh\:mm")</td><td>@(a.Patient?.FullName ?? "N/A")</td><td>@(a.Doctor?.FullName ?? "N/A")</td><td>@(a.Office?.Address ?? "N/A")</td><td>@(a.Approval ? "Yes" : "No")</td><td>@(a.PATIENT_CONFIRM == true ? "Yes" : "No")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
