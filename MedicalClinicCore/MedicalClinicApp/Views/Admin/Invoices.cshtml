@model List<MedicalClinicApp.Models.Invoice>
@{ ViewData["Title"] = "Invoices"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-receipt"></i> Invoices</h2>
    <a asp-action="Index" class="btn btn-outline-primary mb-3"><i class="bi bi-arrow-left"></i> Back</a>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Patient</th><th>Total</th><th>Claim</th><th>Paid</th><th>Due Date</th></tr></thead>
                <tbody>
                @foreach (var i in Model)
                { <tr><td>@i.InvoiceID</td><td>@(i.Patient?.FullName ?? "N/A")</td><td>@(i.Total?.ToString("C"))</td><td>@(i.Claim?.ToString("C"))</td><td>@(i.PaidAmount?.ToString("C"))</td><td>@i.DueDate?.ToString("MMM dd, yyyy")</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
