@model MedicalClinicApp.Models.Office
@{ ViewData["Title"] = "Add Office"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-building"></i> Add Office</h2>
    <div class="card p-4">
        <form asp-action="AddOffice" method="post">
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label">Address</label><input asp-for="Address" class="form-control" required /></div>
                <div class="col-md-4"><label class="form-label">Phone</label><input asp-for="Phone" class="form-control" /></div>
                <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Add Office</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
            </div>
        </form>
    </div>
</div>
