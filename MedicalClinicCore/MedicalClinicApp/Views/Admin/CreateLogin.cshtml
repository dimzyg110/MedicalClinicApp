@model MedicalClinicApp.Models.Login
@{ ViewData["Title"] = "Create Login"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-key"></i> Create Login</h2>
    <div class="card p-4">
        <form asp-action="CreateLogin" method="post">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Username</label><input asp-for="Username" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">Password</label><input asp-for="Password" class="form-control" required /></div>
                <div class="col-md-3"><label class="form-label">Doctor ID</label><input asp-for="DoctorID" type="number" class="form-control" />
                    <small class="text-muted">@foreach (var d in (List<MedicalClinicApp.Models.Doctor>)ViewBag.Doctors) { <text>@d.DoctorID: @d.FullName, </text> }</small>
                </div>
                <div class="col-md-3"><label class="form-label">Nurse ID</label><input asp-for="NurseID" type="number" class="form-control" />
                    <small class="text-muted">@foreach (var n in (List<MedicalClinicApp.Models.Nurse>)ViewBag.Nurses) { <text>@n.NID: @n.FullName, </text> }</small>
                </div>
                <div class="col-md-3"><label class="form-label">Patient ID</label><input asp-for="PatientID" type="number" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label">Admin ID</label><input asp-for="AdminID" type="number" class="form-control" /></div>
                <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Create Login</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
            </div>
        </form>
    </div>
</div>
