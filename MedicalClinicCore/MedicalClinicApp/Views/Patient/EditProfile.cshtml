@model MedicalClinicApp.Models.Patient
@{ ViewData["Title"] = "Edit Profile"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-pencil"></i> Edit Profile</h2>
    <div class="card p-4">
        <form asp-action="EditProfile" method="post">
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">First Name</label><input asp-for="FName" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">Middle Name</label><input asp-for="MName" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">Last Name</label><input asp-for="LName" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Phone</label><input asp-for="Phone" class="form-control" /></div>
                <div class="col-md-8"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">Gender</label><select asp-for="Gender" class="form-select"><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></div>
                <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Save</button> <a asp-controller="Patient" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a></div>
            </div>
        </form>
    </div>
</div>
