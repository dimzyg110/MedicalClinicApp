@model List<MedicalClinicApp.Models.Invoice>
@{ ViewData["Title"] = "Billing"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-receipt"></i> My Invoices</h2>
    <a asp-action="Dashboard" class="btn btn-outline-primary mb-3"><i class="bi bi-arrow-left"></i> Back</a>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>ID</th><th>Total</th><th>Insurance Claim</th><th>Paid</th><th>Balance</th><th>Due Date</th></tr></thead>
                <tbody>
                @foreach (var i in Model)
                {
                    var balance = (i.Total ?? 0) - (i.Claim ?? 0) - (i.PaidAmount ?? 0);
                    <tr><td>@i.InvoiceID</td><td>@(i.Total?.ToString("C"))</td><td>@(i.Claim?.ToString("C"))</td><td>@(i.PaidAmount?.ToString("C"))</td><td class="@(balance > 0 ? "text-danger fw-bold" : "text-success")">@balance.ToString("C")</td><td>@i.DueDate?.ToString("MMM dd, yyyy")</td></tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No invoices</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
