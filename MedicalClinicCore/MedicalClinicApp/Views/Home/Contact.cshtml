@{ ViewData["Title"] = "Contact"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-envelope"></i> Contact Us</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card p-4 h-100">
                <h5><i class="bi bi-geo-alt text-primary"></i> Address</h5>
                <p>123 Medical Center Drive<br/>Healthcare City, HC 12345</p>
                <h5><i class="bi bi-telephone text-primary"></i> Phone</h5>
                <p>(555) 123-4567</p>
                <h5><i class="bi bi-envelope text-primary"></i> Email</h5>
                <p>info@medicalclinic.com</p>
                <h5><i class="bi bi-clock text-primary"></i> Hours</h5>
                <p>Monday - Friday: 8:00 AM - 6:00 PM<br/>Saturday: 9:00 AM - 1:00 PM<br/>Sunday: Closed</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-4 h-100">
                <h5>Send us a message</h5>
                <form>
                    <div class="mb-3"><label class="form-label">Name</label><input type="text" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Message</label><textarea class="form-control" rows="4"></textarea></div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Send</button>
                </form>
            </div>
        </div>
    </div>
</div>
