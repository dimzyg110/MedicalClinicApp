@{ ViewData["Title"] = "Home"; }

<div class="hero-section text-center">
    <div class="container">
        <h1>Welcome to Medical Clinic</h1>
        <p class="lead mt-3">Your health is our priority. Professional healthcare services with compassionate care.</p>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="PatientLogin" class="btn btn-light btn-lg me-2"><i class="bi bi-person"></i> Patient Portal</a>
            <a asp-controller="Account" asp-action="DoctorLogin" class="btn btn-outline-light btn-lg me-2"><i class="bi bi-heart-pulse"></i> Doctor Portal</a>
            <a asp-controller="Account" asp-action="NurseLogin" class="btn btn-outline-light btn-lg me-2"><i class="bi bi-clipboard2-pulse"></i> Nurse Portal</a>
            <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-outline-light btn-lg"><i class="bi bi-shield-lock"></i> Admin Portal</a>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card p-4 text-center h-100">
                <i class="bi bi-calendar-check text-primary" style="font-size: 3rem;"></i>
                <h4 class="mt-3">Easy Scheduling</h4>
                <p class="text-muted">Book appointments online with your preferred doctor at your convenience.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 text-center h-100">
                <i class="bi bi-file-medical text-success" style="font-size: 3rem;"></i>
                <h4 class="mt-3">Digital Records</h4>
                <p class="text-muted">Access your medical records, prescriptions, and visit reports securely online.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 text-center h-100">
                <i class="bi bi-people text-info" style="font-size: 3rem;"></i>
                <h4 class="mt-3">Expert Doctors</h4>
                <p class="text-muted">Our team of specialists covers cardiology, neurology, dermatology, and more.</p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h2 class="section-title">Our Specializations</h2>
    <div class="row g-3 mt-2">
        @foreach (var spec in new[] { ("bi-heart-pulse", "Cardiology"), ("bi-eye", "Dermatology"), ("bi-lightning", "Neurology"), ("bi-shield-plus", "Oncology"), ("bi-droplet", "Nephrology"), ("bi-bandaid", "Internal Medicine"), ("bi-person-check", "PCP") })
        {
            <div class="col-md-3 col-6">
                <div class="card p-3 text-center">
                    <i class="bi @spec.Item1 text-primary" style="font-size: 2rem;"></i>
                    <h6 class="mt-2 mb-0">@spec.Item2</h6>
                </div>
            </div>
        }
    </div>
</div>
