@{ ViewData["Title"] = "About Us"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-info-circle"></i> About Us</h2>
    <div class="card p-4">
        <p>Medical Clinic Management System is a comprehensive healthcare platform designed to streamline clinic operations, improve patient care, and enhance communication between healthcare providers and patients.</p>
        <p>Our system supports multiple user roles including administrators, doctors, nurses, and patients, each with tailored dashboards and functionality.</p>
        <h5 class="mt-4">Key Features</h5>
        <ul>
            <li>Online appointment scheduling and management</li>
            <li>Electronic medical records and visit reports</li>
            <li>Prescription management</li>
            <li>Billing and invoice tracking</li>
            <li>Multi-office support</li>
            <li>Role-based access control</li>
        </ul>
    </div>
</div>
