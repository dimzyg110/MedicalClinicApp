@model List<MedicalClinicApp.Models.Doctor>
@{ ViewData["Title"] = "Our Doctors"; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-people"></i> Our Doctors</h2>
    <div class="row g-4">
        @foreach (var d in Model)
        {
            <div class="col-md-4">
                <div class="card p-4 text-center h-100">
                    <i class="bi bi-person-circle text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">@d.FullName</h5>
                    <p class="text-muted mb-1">@d.Specialization</p>
                    <p class="small"><i class="bi bi-envelope"></i> @d.Email</p>
                </div>
            </div>
        }
        @if (!Model.Any()) { <div class="col-12"><p class="text-muted text-center">No doctors available.</p></div> }
    </div>
</div>
