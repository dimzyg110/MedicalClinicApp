@model MedicalClinicApp.ViewModels.NurseDashboardViewModel
@{ ViewData["Title"] = "Nurse Dashboard"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="section-title"><i class="bi bi-clipboard2-pulse"></i> Welcome, @Model.Nurse.FullName</h2>
            <p class="text-muted"><i class="bi bi-geo-alt"></i> Office: @(Model.Nurse.Office?.Address ?? "Not assigned")</p>
        </div>
        <div>
            <a asp-action="PatientReports" class="btn btn-outline-primary me-2"><i class="bi bi-file-medical"></i> My Reports</a>
            <a asp-action="Prescriptions" class="btn btn-outline-success"><i class="bi bi-capsule"></i> Prescriptions</a>
        </div>
    </div>

    <h4><i class="bi bi-calendar-day"></i> Today's Appointments</h4>
    <div class="card mb-4">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Office</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var a in Model.TodayAppointments)
                {
                    <tr>
                        <td>@a.AppointmentTime?.ToString(@"hh\:mm")</td>
                        <td>@(a.Patient?.FullName ?? "N/A")</td>
                        <td>@(a.Doctor?.FullName ?? "N/A")</td>
                        <td>@(a.Office?.Address ?? "N/A")</td>
                        <td>@if (a.Approval) { <span class="badge-approved">Approved</span> } else { <span class="badge-pending">Pending</span> }</td>
                        <td><a asp-action="CreateReport" asp-route-appointmentId="@a.AppointmentID" class="btn btn-sm btn-info text-white"><i class="bi bi-file-medical"></i> Create Report</a></td>
                    </tr>
                }
                @if (!Model.TodayAppointments.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No appointments today</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
