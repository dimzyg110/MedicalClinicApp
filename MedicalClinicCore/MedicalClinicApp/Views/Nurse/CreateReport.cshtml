@model MedicalClinicApp.Models.VisitDetails
@{ ViewData["Title"] = "Create Visit Report"; var appt = (MedicalClinicApp.Models.Appointment)ViewBag.Appointment; }
<div class="container mt-4">
    <h2 class="section-title"><i class="bi bi-file-medical"></i> Create Visit Report</h2>
    <p class="text-muted">Patient: <strong>@(appt.Patient?.FullName ?? "N/A")</strong> | Date: @appt.AppointmentDate?.ToString("MMM dd, yyyy")</p>
    <div class="card p-4">
        <form asp-action="CreateReport" method="post">
            <input type="hidden" asp-for="AppointmentID" />
            <input type="hidden" asp-for="PatientID" />
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Diagnosis</label><input asp-for="Diagnosis" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">Treatment</label><input asp-for="Treatment" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">Blood Pressure</label><input asp-for="BloodPressure" class="form-control" placeholder="120/80" /></div>
                <div class="col-md-4"><label class="form-label">Heart Rate</label><input asp-for="HeartRate" class="form-control" placeholder="72" /></div>
                <div class="col-md-4"><label class="form-label">Weight</label><input asp-for="Weight" class="form-control" /></div>
                <div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="4"></textarea></div>
                <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Save Report</button> <a asp-controller="Nurse" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a></div>
            </div>
        </form>
    </div>
</div>
